# Copy this file to backend/.env and fill in your local values.
# Use the password you set when installing PostgreSQL (letters and digits only, so it needs no special encoding).
DATABASE_URL=postgres://postgres:YOUR_PASSWORD@localhost:5432/cover_check_dev
LINK_TOKEN_SECRET=local-dev-secret-at-least-32-characters-long
AGENT_API_KEY=dev-agent-key
NOTICE_VERSION=v1
DOC_RETENTION_DAYS=90

# Supabase Storage (server-side only; keep commented for local-disk development).
# STORAGE_DRIVER=supabase
# STORAGE_BUCKET=cover-check-docs
# SUPABASE_URL=https://YOUR_PROJECT.supabase.co
# SUPABASE_SERVICE_ROLE_KEY=
# DOCUMENT_ENCRYPTION_KEY=  # generate with node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
CORS_ORIGIN=http://localhost:5173

# --- Solo run on your laptop: leave everything below commented out.
#     WhatsApp sends and OTP codes are printed in the API terminal instead.

# --- Test inside the organisation (colleagues open the app over the office network) -----------------------------
# Address colleagues will open. Use the laptop's fixed office IP (run `ipconfig`, look for IPv4) and the API port.
# PUBLIC_BASE_URL=http://10.1.2.3:8080
# Serve the built web app from the API (run the build first, see docs/LAPTOP_TEST.md). One address, one port.
# WEB_DIST=../frontend/dist
# manual = colleagues type the key details from their policy (what the pilot does). demo shows fixed example facts.
# EXTRACTOR=manual

# Real WhatsApp through Gupshup. Without these the messages and OTPs print in the API terminal.
# WHATSAPP_PROVIDER=gupshup
# GUPSHUP_API_KEY=
# GUPSHUP_APP_NAME=turtlemint
# GUPSHUP_SOURCE_NUMBER=            # your WhatsApp business number, digits only, starting 91
# WA_SUMMARY_TEMPLATE_ID=           # the template id Gupshup shows for the approved summary template (not the name)
# GUPSHUP_OTP_TEMPLATE_ID=          # the template id of the approved OTP template
