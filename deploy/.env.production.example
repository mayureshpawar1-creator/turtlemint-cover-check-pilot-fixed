# Cover Check — production settings. Copy to .env.production (never commit it) or put these in your
# cloud's secrets manager. The app refuses to start if anything here is still a laptop-only value.

NODE_ENV=production
PORT=8080
PUBLIC_BASE_URL=https://covercheck.example.com
CORS_ORIGIN=https://covercheck.example.com

# Database. With docker compose, DATABASE_URL is set for you. On AWS RDS use DATABASE_SSL=require
# and point DATABASE_SSL_CA at the RDS CA bundle (e.g. /app/certs/ap-south-1-bundle.pem) — required in production.
# Two logins (create them with deploy/db-roles.sql): the app runs least-privileged, migrations run as the schema owner.
# DATABASE_URL=postgres://cc_app:password@host:5432/cover_check
# MIGRATION_DATABASE_URL=postgres://cc_migrate:password@host:5432/cover_check
DATABASE_SSL=require
# DATABASE_SSL_CA=/app/certs/ap-south-1-bundle.pem

# Secrets — generate each with:  openssl rand -base64 48
LINK_TOKEN_SECRET=
AGENT_API_KEY=

# WhatsApp through AiSensy. Create two API campaigns (status Live) on the approved templates:
#   1. summary  — utility template with 5 variables (see docs/DEPLOY.md)
#   2. otp      — authentication template with a "Copy code" button
WHATSAPP_PROVIDER=aisensy
AISENSY_API_KEY=
AISENSY_SUMMARY_CAMPAIGN=
AISENSY_OTP_CAMPAIGN=cover_check_otp_v1
# If the approved AiSensy/Gupshup OTP template is unavailable, complete all Exotel values below to use SMS fallback.
EXOTEL_API_KEY=
EXOTEL_API_TOKEN=
EXOTEL_ACCOUNT_SID=
EXOTEL_SENDER_ID=
EXOTEL_DLT_ENTITY_ID=
EXOTEL_DLT_TEMPLATE_ID=
EXOTEL_ENDPOINT=

# Inbound WhatsApp replies (STOP). Secret the BSP's webhook must present — required, the app will not start without it.
# Callback URL for the BSP: https://<your-domain>/api/v1/webhooks/whatsapp — the BSP must send this value in the
# x-webhook-secret header (a ?secret= in the URL is refused, so it never lands in access logs).
# Generate with:  openssl rand -base64 24
WEBHOOK_SECRET=

# If you send through Gupshup instead of AiSensy, set these (and WHATSAPP_PROVIDER=gupshup above):
# GUPSHUP_API_KEY=
# GUPSHUP_APP_NAME=turtlemint
# GUPSHUP_SOURCE_NUMBER=            # the WhatsApp business number, digits only, with 91
# WA_SUMMARY_TEMPLATE_ID=           # id of the approved summary template (required for Gupshup)
# GUPSHUP_OTP_TEMPLATE_ID=          # id of the approved authentication (OTP) template

# Policy reading: manual means no auto-extracted values are invented; customer-entered fields need review.
# pdf-text is deliberately blocked in production until OCR/security/accuracy validation is approved.
# demo is refused in production.
EXTRACTOR=manual

# Set true only after documented Turtlemint Advisory/Product/Compliance sign-off for all quiz advice rules.
ADVISORY_RULES_APPROVED=false
# Set true only after Turtlemint IT/Infosec has approved the storage/vendor/data-processing arrangement.
DATA_PROCESSING_APPROVED=false

# Private Supabase Storage bucket. Create it as PRIVATE in the Supabase dashboard first.
STORAGE_DRIVER=supabase
STORAGE_BUCKET=cover-check-docs
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_SERVICE_ROLE_KEY=
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# Store the output only as a Render secret. Losing it makes existing encrypted documents unreadable.
DOCUMENT_ENCRYPTION_KEY=

NOTICE_VERSION=v1
DOC_RETENTION_DAYS=90
LINK_TOKEN_TTL_DAYS=7
# Browser session after the link is opened (HttpOnly cookie)
WEB_SESSION_HOURS=72
